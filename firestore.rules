rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection testing
    match /test/connection {
      allow read: if true;
    }

    // User profiles: Only the authenticated user can read or write their own profile
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && (incoming().uid == userId || incoming().id == userId)
        && incoming().email is string
        && incoming().displayName is string;
      allow list, delete: if false;
    }

    // Orders: Authenticated users can create orders and view their own orders
    match /orders/{orderId} {
      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid
        && incoming().total is number
        && incoming().paymentMethod in ['PIX', 'CREDIT_CARD']
        && incoming().status in ['PENDING', 'PAID'];
      
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() 
        && resource.data.userId == request.auth.uid
        && incoming().userId == request.auth.uid;
      allow delete: if false;
    }

    // Reviews: Public read, authenticated creation and update by author
    match /reviews/{reviewId} {
      allow get, list: if true;
      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid
        && incoming().rating is number
        && incoming().comment is string;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Products: Public read for browsing catalog
    match /products/{productId} {
      allow get, list: if true;
      allow write: if false;
    }
  }
}
